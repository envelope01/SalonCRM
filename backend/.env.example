# Backend environment template
# Copy to .env.development for local work. In Render, set these in the Backend Service dashboard.

NODE_ENV=development
PORT=5000

# Azure SQL connection string.
DATABASE_URL=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=saloncrm_prod;Persist Security Info=False;User ID=saloncrmadmin;Password=replace-with-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Comma-separated frontend origins allowed by CORS.
# Local: http://localhost:3000,http://localhost:5173
# Render: https://your-frontend-service.onrender.com
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Use a long random value per environment.
JWT_SECRET=replace-with-a-long-random-secret

