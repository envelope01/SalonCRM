{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "tsx scripts/start-production.ts",
    "build": "npm run db:migrate:prod",
    "dev": "npm run db:ensure:appointments && cross-env NODE_ENV=development nodemon --exec tsx server.js",
    "db:generate": "cross-env NODE_ENV=development drizzle-kit generate",
    "db:migrate": "cross-env NODE_ENV=development drizzle-kit migrate",
    "db:ensure:appointments": "cross-env NODE_ENV=development tsx scripts/ensure-appointments-table.ts",
    "db:migrate:prod": "tsx scripts/run-pg-migrations.ts",
    "db:migrate:kit:prod": "drizzle-kit migrate",
    "db:push:prod": "drizzle-kit push --verbose",
    "db:push:prod:force": "drizzle-kit push --verbose --force",
    "db:check:tables": "tsx scripts/check-pg-tables.ts",
    "db:backfill:demo": "cross-env NODE_ENV=development tsx scripts/backfill-demo-tenant.ts",
    "db:seed:local-demo": "cross-env NODE_ENV=development tsx scripts/seed-local-demo-tenant.ts",
    "db:repair:local": "cross-env NODE_ENV=development tsx scripts/repair-local-tenant-db.ts",
    "render:build": "npm run db:migrate:prod",
    "render:start": "npm run db:migrate:prod && npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.11",
    "typescript": "^7.0.2"
  }
}
