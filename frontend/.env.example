# Frontend environment template for Create React App
# Copy to .env.development for local work or configure in your cloud build settings.

# Development auto mode:
# - http://localhost:3000 uses http://localhost:5000/api
# - http://192.168.x.x:3000 uses http://192.168.x.x:5000/api
# - No router IP changes are needed as long as you open the phone UI using CRA's "On Your Network" URL.
REACT_APP_API_BASE_URL=auto
REACT_APP_DEV_API_PORT=5000

# Optional explicit local override:
# REACT_APP_API_BASE_URL=http://localhost:5000/api
# REACT_APP_DEV_API_HOST=192.168.1.114

# Render production value:
# REACT_APP_API_BASE_URL=https://your-backend-service.onrender.com/api
