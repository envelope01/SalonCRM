# Frontend environment template for Create React App
# Copy to .env.development for local work or configure in your cloud build settings.

# Development auto mode:
# - http://localhost:3000 uses http://localhost:5000/api
# - http://192.168.x.x:3000 uses http://192.168.x.x:5000/api
# - No router IP changes are needed as long as you open the phone UI using CRA's "On Your Network" URL.
REACT_APP_API_BASE_URL=auto
REACT_APP_DEV_API_PORT=5000

# Optional explicit local override:
# REACT_APP_API_BASE_URL=http://localhost:5000/api
# REACT_APP_DEV_API_HOST=192.168.1.114

# Render production value:
# REACT_APP_API_BASE_URL=https://your-backend-service.onrender.com/api

# Optional public URLs included in WhatsApp bill messages.
# Update these whenever your payment, Instagram, or review links change.
REACT_APP_PAYMENT_URL=https://example.com/payment-or-payment-qr
REACT_APP_INSTAGRAM_URL=https://instagram.com/your_salon
REACT_APP_GOOGLE_REVIEW_URL=https://g.page/r/your-review-link
REACT_APP_BILL_MESSAGE_TEMPLATE="Hi *{{CustomerName}}*! 😊\n\nThank you for visiting our salon! ❤️\n\n🧾 *Services Taken:*\n{{ServicesList}}\n\n💰 *Subtotal:* ₹{{SubtotalAmount}}\n{{DiscountSection}}\n🧾 *Your Bill Amount:* ₹{{BillAmount}}\n\nWe're grateful for your visit and look forward to serving you again.\n\n💳 *Pay Online:*\n{{PaymentURL}}\n\n📸 *Follow us on Instagram:*\n{{InstagramURL}}\n\n⭐ *Loved your experience? Please leave us a Google Review:*\n{{GoogleReviewURL}}\n\nYour feedback means a lot to us and helps us serve you even better. Thank you for your support! 🙏"
REACT_APP_BILL_SERVICE_LINE_TEMPLATE="{{Index}}. {{ServiceName}} - ₹{{ServiceAmount}}"
REACT_APP_BILL_DISCOUNT_LINE_TEMPLATE="🎉 *You Saved:* ₹{{DiscountAmount}} ({{DiscountPercent}}% discount)"
